{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022"],

    "strict": true,
    "strictPropertyInitialization": true,

    "moduleResolution": "node",
    "esModuleInterop": true,
    "resolveJsonModule": true,

    "declaration": true,

    "inlineSourceMap": true,
    "inlineSources": true,

    "experimentalDecorators": true,

    "skipLibCheck": true,
    "isolatedModules": true
  },
  "exclude": ["cdk.out", "node_modules"]
}
